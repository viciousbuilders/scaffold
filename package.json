{
  "name": "scaffold",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "node scripts/launch-desktop.mjs --dev",
    "desktop:prepare": "node scripts/clean-desktop.mjs && npm run icon:build && npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && node scripts/launch-desktop.mjs",
    "desktop:package": "npm run desktop:prepare && node scripts/package-desktop.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "desktop:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.5.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Local coding, math and quant practice with your own AI CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/viciousbuilders/scaffold.git"
  },
  "homepage": "https://viciousbuilders.com/scaffold"
}
